# ==========================================================
# Pousada Azimute — configuração do servidor (Apache / LiteSpeed)
# Se o seu domínio NÃO for pousadaazimute.com.br, troque o nome
# nas 2 linhas marcadas com [DOMINIO] abaixo.
# ==========================================================

Options -Indexes
DirectoryIndex index.html index.php
ErrorDocument 404 /404.html
ServerSignature Off
AddDefaultCharset UTF-8

# ---------- HTTPS e endereço único (sem www) ----------
<IfModule mod_rewrite.c>
RewriteEngine On

# 1) www -> sem www, já em HTTPS (uma só volta)   [DOMINIO]
RewriteCond %{HTTP_HOST} ^www\.pousadaazimute\.com\.br$ [NC]
RewriteRule ^ https://pousadaazimute.com.br%{REQUEST_URI} [L,R=301]

# 2) Tudo em HTTPS. Aceita CDN/proxy que avisa pelo X-Forwarded-Proto
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Bloqueia arquivos ocultos (menos .well-known, usado pelo certificado HTTPS)
<FilesMatch "^\.(?!well-known)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ---------- Cabeçalhos de segurança ----------
<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Só vale em HTTPS. Sem "includeSubDomains" de propósito, para não afetar outros subdomínios
  Header always set Strict-Transport-Security "max-age=31536000"
  # Política de conteúdo: o site só carrega o que está listado aqui
  #   cdnjs.cloudflare.com ........ ícones (Font Awesome)
  #   googletagmanager / google-analytics ... Analytics (só roda se você ativar no analytics.js)
  #   google.com / maps.google.com ... mapa da página Contato
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' https://cdnjs.cloudflare.com; font-src 'self' https://cdnjs.cloudflare.com; img-src 'self' data: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://www.google.com https://maps.google.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
</IfModule>

# ---------- Velocidade: compressão e cache ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json application/xml image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 week"
  ExpiresByType image/png "access plus 1 week"
  ExpiresByType image/webp "access plus 1 week"
  ExpiresByType image/x-icon "access plus 1 week"
  ExpiresByType image/vnd.microsoft.icon "access plus 1 week"
  ExpiresByType text/css "access plus 1 day"
  ExpiresByType text/javascript "access plus 1 day"
  ExpiresByType application/javascript "access plus 1 day"
</IfModule>

# Os preços mudam pelo painel: o navegador sempre confere se há versão nova
<IfModule mod_headers.c>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
