# Painel: nunca guardar em cache, nunca indexar e política de conteúdo mais restrita
Options -Indexes

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store"
  Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  Header always set Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' https://cdnjs.cloudflare.com; font-src https://cdnjs.cloudflare.com; img-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'none'"
</IfModule>
